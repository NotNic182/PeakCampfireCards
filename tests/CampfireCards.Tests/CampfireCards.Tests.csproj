<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Unity-free card logic (registry, draws, modifier stacking, timers). Runs with: dotnet test tests/CampfireCards.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\CampfireCards\Core\*.cs" Link="Core\%(Filename).cs" />
    <Compile Include="..\..\src\CampfireCards\Generated\CardTable.cs" Link="Generated\CardTable.cs" />
    <Compile Include="..\..\src\CampfireCards\Generated\ClimbStats.cs" Link="Generated\ClimbStats.cs" />
    <!-- wire format and dispatch; the game-side handlers are replaced by NetStub.cs -->
    <Compile Include="..\..\src\CampfireCards\Generated\NetEvents.cs" Link="Generated\NetEvents.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
