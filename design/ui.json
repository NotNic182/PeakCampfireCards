{
 "_sheet": "Card picker UI (uGUI, built at runtime, no asset bundle). One row = one UI element. Generated/UiLayout.cs gets a static class per row with its Size, Text template and every entry of consts (numbers become float consts, 4-number arrays become Colors, strings become string consts). Fonts: the game's own TMP font found at runtime; ROUNDS supplies textures (CardBG, icons) and colours.",
 "_columns": {
  "id": "element name",
  "parent": "parent element id or root",
  "size": "[w,h] in reference pixels (CanvasScaler 1920x1080)",
  "anchor": "where it sits",
  "visual": "what it looks like, in words",
  "text": "static text, or {var} placeholders",
  "consts": "named numbers / colours / strings the code needs for this element",
  "behaviour": "interaction and animation",
  "soundOn": "rounds_assets.json audioKeys entry played, or none"
 },
 "canvas": {
  "referenceResolution": [
   1920,
   1080
  ],
  "sortingOrder": 500
 },
 "timing": {
  "pickTimeoutSeconds": 60,
  "fanSlideInSeconds": 0.35,
  "cardStaggerSeconds": 0.08,
  "hoverScale": 1.08,
  "selectedFlashSeconds": 0.5,
  "toastSeconds": 3.0,
  "missingNoticeSeconds": 12.0,
  "openingPickDelaySeconds": 2.0
 },
 "rows": [
  {
   "id": "PickerWindow",
   "parent": "root",
   "size": [
    1920,
    1080
   ],
   "anchor": "stretch",
   "visual": "MenuWindow subclass (blocksPlayerInput, showCursorWhileOpen) with a dark backdrop",
   "text": "",
   "consts": {
    "Backdrop": [
     0,
     0,
     0,
     0.72
    ]
   },
   "behaviour": "Open() when it is the local player's turn; Close() after a pick or timeout; the game blocks movement and shows the cursor through MenuWindow",
