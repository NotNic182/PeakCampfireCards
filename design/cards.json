{
  "_sheet": "The deck. One row = one card. Name, rarity, benefit and drawback text, modifiers, ability handler and parameters all live here; Generated/CardTable.cs gets one CardDef per row. Every value can be overridden in the BepInEx config (section per card key).",
  "_columns": {
    "id": "stable card id (1-255), sent over the network; never reuse",
    "key": "C# identifier, also the config section name",
    "name": "card name shown on the card",
    "rarity": "common | uncommon | rare | legendary | mythic",
    "category": "climbing | stamina | environment | survival | inventory | team | mutation | wildcard | mythic",
    "type": "short type label from the spec",
    "positive": "benefit text shown on the card",
    "negative": "drawback text shown on the card (empty only for mythic cards)",
    "flavor": "optional italic line",
    "multiplayerOnly": "true = never offered in solo play",
    "drawsCards": "true = acquiring it grants more cards (bonus draws never include these)",
    "mods": "list of [channel, op, value, when, target]: channel from stats.json; op mul|add|set; when from conditions.json; target self|team|teamAndSelf (team = other scouts within params.radius)",
    "ability": "handler class Ability_<name> in src/CampfireCards/Abilities, or empty for pure modifier cards",
    "params": "numbers the ability uses (radius, cooldowns, amounts in 100-unit scale / 100)",
    "theme": "colour theme for the art window",
    "art": "art motif id from art.json"
  },
