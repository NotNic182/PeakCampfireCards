    "spin": "rotates speed degrees/s",
    "pulse": "scale 1 +- amp, speed cycles/s",
    "drift": "rises amp px over 1/speed s then restarts, fading out (negative amp falls)",
    "flicker": "fast irregular scale and alpha wobble of size amp",
    "orbit": "circles its pos at radius amp, speed cycles/s",
    "sway": "rotates +- amp degrees, speed cycles/s"
  },
