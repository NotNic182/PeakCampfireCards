    "id": "motif id referenced by cards.json",
    "description": "what it should read as",
    "layers": "ordered back to front; each {shape, color, size:[w,h], pos:[x,y], rot, anim, amp, speed, phase, alpha}"
  },
  "shapes": ["circle", "ring", "triangle", "diamond", "star", "spark", "drop", "flame", "chevron", "crescent", "wave", "rounded", "plus", "shield"],
